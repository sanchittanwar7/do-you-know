# --- Meta (Instagram Graph API) ---
META_APP_ID=
META_APP_SECRET=
REDIRECT_URI=http://localhost:5001/callback
PORT=5001
# Keep this current; see Meta's Graph API version schedule before upgrading.
META_GRAPH_VERSION=v26.0
# Optional: required only if your Facebook account manages multiple Pages linked to Instagram.
META_PAGE_ID=
# DeepSeek generates the text rendered into each carousel. Keep this true unless Meta's
# AI-generated-content label does not apply to your particular output.
META_CONTENT_IS_AI_GENERATED=true

# --- DeepSeek ---
DEEPSEEK_API_KEY=
# DeepSeek API model id. Default deepseek-chat (V3). Swap here if you have another id.
DEEPSEEK_MODEL=deepseek-flash

# --- Supabase Storage (S3-compatible image hosting for IG) ---
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
# https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_ENDPOINT=
# project region, e.g. us-east-1
SUPABASE_REGION=us-east-1
SUPABASE_BUCKET=do-you-know
# https://<project-ref>.supabase.co/storage/v1/object/public/do-you-know
SUPABASE_PUBLIC_BASE=

# --- Telegram (approval bot) ---
TELEGRAM_BOT_TOKEN=
# Your personal chat id; only this chat can approve/reject and run commands.
TELEGRAM_CHAT_ID=

# --- Daily scheduler (IST by default) ---
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
SCHEDULE_TZ=Asia/Kolkata

# --- Flask ---
FLASK_SECRET=change-me-to-random
